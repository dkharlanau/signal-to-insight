{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/signal-to-insight/schemas/knowledge-delta.schema.json",
  "title": "Signal to Insight knowledge delta records",
  "type": "object",
  "required": ["version", "records"],
  "properties": {
    "version": {"type": "string"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["insight_id", "summary", "items", "suppressed_prior_matches"],
        "properties": {
          "insight_id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["relationship", "concept_id", "label", "source_basis", "prior_basis", "interpretation", "evidence_insights"],
              "properties": {
                "relationship": {"enum": ["new", "reinforces", "refines", "contradicts"]},
                "concept_id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "source_basis": {"type": "string", "minLength": 1},
                "prior_basis": {"type": "string", "minLength": 1},
                "interpretation": {"type": "string", "minLength": 1},
                "evidence_insights": {"type": "array", "items": {"type": "string", "minLength": 1}}
              },
              "additionalProperties": false
            }
          },
          "suppressed_prior_matches": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

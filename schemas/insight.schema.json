{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/signal-to-insight/schemas/insight.schema.json",
  "title": "Signal to Insight insight collection",
  "type": "object",
  "required": ["project", "insights"],
  "properties": {
    "project": {"type": "object"},
    "insights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source_id", "slug", "status", "title", "one_liner", "why_this_matters", "whole_source_map", "derived_model", "coherence_review", "visual_plan", "concepts", "tool_map", "examples", "limitations", "action_map", "supporting_sources", "provenance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "status": {"type": "string", "enum": ["draft", "review", "published", "archived"]},
          "title": {"type": "string", "minLength": 1},
          "one_liner": {"type": "string", "minLength": 1},
          "source": {"type": "object"},
          "why_this_matters": {"type": "string"},
          "whole_source_map": {
            "type": "object",
            "required": ["problem", "thesis", "core_topics"]
          },
          "derived_model": {
            "type": "object",
            "required": ["problem", "mechanism", "result"]
          },
          "coherence_review": {
            "type": "object",
            "required": ["central_chain", "prerequisites_complete", "source_vs_enrichment_clear", "open_gaps", "scores"],
            "properties": {
              "central_chain": {"type": "array", "minItems": 2, "items": {"type": "string"}},
              "prerequisites_complete": {"type": "boolean"},
              "source_vs_enrichment_clear": {"type": "boolean"},
              "open_gaps": {"type": "array", "items": {"type": "string"}},
              "scores": {
                "type": "object",
                "required": ["coherence", "prerequisite_completeness", "evidence_confidence", "practical_leverage"],
                "properties": {
                  "coherence": {"type": "integer", "minimum": 1, "maximum": 5},
                  "prerequisite_completeness": {"type": "integer", "minimum": 1, "maximum": 5},
                  "evidence_confidence": {"type": "integer", "minimum": 1, "maximum": 5},
                  "practical_leverage": {"type": "integer", "minimum": 1, "maximum": 5}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "visual_plan": {
            "type": "object",
            "required": ["dominant", "supporting", "image"],
            "properties": {
              "dominant": {
                "type": "object",
                "required": ["type", "title", "nodes"],
                "properties": {
                  "type": {"type": "string", "enum": ["causal_chain", "sequence", "layers", "comparison", "decision"]},
                  "title": {"type": "string"},
                  "nodes": {
                    "type": "array",
                    "minItems": 2,
                    "items": {
                      "type": "object",
                      "required": ["label", "title", "text"],
                      "properties": {
                        "label": {"type": "string"},
                        "title": {"type": "string"},
                        "text": {"type": "string"}
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              },
              "supporting": {
                "type": "array",
                "items": {"type": "string", "enum": ["causal_chain", "sequence", "layers", "comparison", "decision", "concept_grid", "tool_map", "examples", "limitations", "action_map", "source_map"]}
              },
              "image": {
                "type": "object",
                "required": ["needed", "reason"],
                "properties": {
                  "needed": {"type": "boolean"},
                  "reason": {"type": "string"}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "concepts": {"type": "array"},
          "patterns": {"type": "array"},
          "tool_map": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "category", "why_explore", "url", "relationship", "status"],
              "properties": {
                "name": {"type": "string"},
                "category": {"type": "string"},
                "why_explore": {"type": "string"},
                "url": {"type": "string", "format": "uri"},
                "relationship": {"type": "string"},
                "status": {"type": "string", "enum": ["use_now", "try", "learn", "build", "watch", "ignore_for_now"]}
              }
            }
          },
          "examples": {"type": "array"},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "action_map": {
            "type": "object",
            "required": ["use_now", "try", "learn", "build", "watch", "ignore_for_now"],
            "properties": {
              "use_now": {"type": "array", "items": {"type": "string"}},
              "try": {"type": "array", "items": {"type": "string"}},
              "learn": {"type": "array", "items": {"type": "string"}},
              "build": {"type": "array", "items": {"type": "string"}},
              "watch": {"type": "array", "items": {"type": "string"}},
              "ignore_for_now": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "connections": {"type": "array"},
          "supporting_sources": {"type": "array"},
          "tags": {"type": "array"},
          "provenance": {
            "type": "object",
            "required": ["source_linked", "source_dates_recorded", "full_transcript_stored", "analysis_type", "reviewed_at"]
          }
        }
      }
    }
  }
}

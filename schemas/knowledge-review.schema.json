{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/signal-to-insight/schemas/knowledge-review.schema.json",
  "title": "Signal to Insight contradiction/refinement review ledger",
  "type": "object",
  "required": ["version", "reviews"],
  "properties": {
    "version": {"type": "string"},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "concept_id", "trigger_insight_id", "candidate_type", "evidence", "scope_check", "resolution", "rationale", "model_change", "status", "reviewed_by", "reviewed_at", "history"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "concept_id": {"type": "string", "minLength": 1},
          "trigger_insight_id": {"type": "string", "minLength": 1},
          "candidate_type": {"enum": ["refinement", "contradiction"]},
          "evidence": {
            "type": "object",
            "required": ["new_claim_ids", "prior_claim_ids"],
            "properties": {
              "new_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "prior_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "scope_check": {
            "type": "object",
            "required": ["same_subject", "same_layer", "same_conditions", "assessment", "explanation"],
            "properties": {
              "same_subject": {"type": "boolean"},
              "same_layer": {"type": "boolean"},
              "same_conditions": {"type": "boolean"},
              "assessment": {"enum": ["same_scope", "different_subject", "different_layer", "different_conditions", "narrower_scope", "broader_scope"]},
              "explanation": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "resolution": {"enum": ["refinement", "contradiction", "different_scope", "not_conflict", "needs_more_evidence"]},
          "rationale": {"type": "string", "minLength": 1},
          "model_change": {
            "type": "object",
            "required": ["kind", "target_id", "before", "after", "reason"],
            "properties": {
              "kind": {"enum": ["none", "concept_definition", "relation"]},
              "target_id": {"type": "string", "minLength": 1},
              "before": {"type": ["object", "string", "null"]},
              "after": {"type": ["object", "string", "null"]},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "status": {"enum": ["open", "resolved"]},
          "reviewed_by": {"type": ["string", "null"]},
          "reviewed_at": {"type": ["string", "null"], "format": "date"},
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["at", "action", "note"],
              "properties": {
                "at": {"type": "string", "format": "date"},
                "action": {"enum": ["candidate_created", "scope_reviewed", "resolved", "model_changed", "reopened"]},
                "note": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/signal-to-insight/schemas/source-revisions.schema.json",
  "title": "Signal to Insight living-source revision baselines",
  "type": "object",
  "required": ["revision_version", "sources"],
  "properties": {
    "revision_version": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "canonical_url", "upstream", "analyzed_revision"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^src-[a-z0-9-]+$"},
          "canonical_url": {"type": "string", "format": "uri"},
          "upstream": {
            "type": "object",
            "required": ["provider", "repository", "tracking_mode"],
            "properties": {
              "provider": {"const": "github"},
              "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
              "tracking_mode": {"enum": ["branch", "release"]},
              "branch": {"type": ["string", "null"]},
              "release": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "analyzed_revision": {
            "type": "object",
            "required": ["kind", "id", "occurred_at", "recorded_at", "capture_quality", "basis"],
            "properties": {
              "kind": {"enum": ["commit", "release"]},
              "id": {"type": "string", "minLength": 1},
              "occurred_at": {"type": ["string", "null"]},
              "recorded_at": {"type": "string", "format": "date"},
              "capture_quality": {"enum": ["direct", "reconstructed"]},
              "basis": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

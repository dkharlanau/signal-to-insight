{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/signal-to-insight/schemas/knowledge-graph.schema.json",
  "title": "Signal to Insight Knowledge Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["graph_version", "updated_at", "concepts", "relations"],
  "properties": {
    "graph_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date"},
    "concepts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary", "domain", "coverage", "insight_ids", "aliases", "tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "label": {"type": "string", "minLength": 2},
          "summary": {"type": "string", "minLength": 10},
          "domain": {"type": "string", "minLength": 2},
          "coverage": {"enum": ["introduced", "explained", "applied"]},
          "insight_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "public": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "coverage", "evidence_insights"],
            "properties": {
              "summary": {"type": "string", "minLength": 10},
              "coverage": {"enum": ["introduced", "explained", "applied"]},
              "evidence_insights": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "type", "rationale", "evidence_insights"],
        "properties": {
          "id": {"type": "string", "pattern": "^rel-[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "type": {"enum": ["depends_on", "enables", "realized_by", "refines", "related_to"]},
          "rationale": {"type": "string", "minLength": 10},
          "evidence_insights": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "public": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rationale", "evidence_insights"],
            "properties": {
              "rationale": {"type": "string", "minLength": 10},
              "evidence_insights": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
